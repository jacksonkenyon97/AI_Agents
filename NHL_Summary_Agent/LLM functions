def get_api_results(query):
    import json
    from datetime import date, timedelta
    from urllib.parse import urlencode
    from urllib.request import Request, urlopen

    end_date = date.today()
    start_date = end_date - timedelta(days=6)

    endpoints = {
        "standings": (
            "https://site.api.espn.com/apis/v2/sports/hockey/nhl/standings"
        ),
        "news": (
            "https://site.api.espn.com/apis/site/v2/sports/hockey/nhl/"
            f"news?{urlencode({'limit': 20})}"
        ),
    }

    results = {"scores": []}
    for day_offset in range(7):
        game_date = start_date + timedelta(days=day_offset)
        date_param = game_date.strftime("%Y%m%d")
        scoreboard_url = (
            "https://site.api.espn.com/apis/site/v2/sports/hockey/nhl/"
            f"scoreboard?{urlencode({'dates': date_param})}"
        )
        request = Request(
            scoreboard_url,
            headers={
                "Accept": "application/json",
                "User-Agent": "NHL-Summary-Agent/1.0",
            },
        )
        with urlopen(request, timeout=20) as response:
            results["scores"].extend(json.load(response).get("events", []))

    for name, url in endpoints.items():
        request = Request(
            url,
            headers={
                "Accept": "application/json",
                "User-Agent": "NHL-Summary-Agent/1.0",
            },
        )
        with urlopen(request, timeout=20) as response:
            results[name] = json.load(response)

    return {
        "query": query,
        "date_range": {
            "start": start_date.isoformat(),
            "end": end_date.isoformat(),
        },
        **results,
    }

